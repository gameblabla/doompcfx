build/
out.bin
doom_pcfx.bin
doom_pcfx.cue
doom_pcfx_t*.bin
doom_pcfx_SONG*.bin
*.o
*.d
*.elf
*.map

# Build stamp recording the current JAGUAR_MAPS mode so a mode switch rebuilds the
# WAD (switching mode changes no other timestamp). Local-only; not source.
src/generated/.jaguar_mode

# Local source/outputs for optional Red Book CD-DA music. The soundtrack is
# user-supplied and the linker regenerates its track-number header and raw tracks.
3DOMusic/
src/generated/cdda_tracks.h
tools/pcfxtools/pcfx-cdlink

# Generated WAD data + game-data WADs (regenerated by `make` from the source
# WADs, which the user provides locally). Not source code; keep them out of git.
src/iwad/
generated/*
# ...EXCEPT the per-map asset manifest: it is an INPUT to the normal build (the pack
# builder reads it), produced by the separate `make mappack-manifest` emulator step,
# so it must be tracked. See tools/gen_pcfx_packs.py / platform/pcfx_mappack.c.
!generated/mappack_manifest.txt
assets/*.wad

# Per-build stamps/references: regenerated every build from the working tree's
# git hashes (buildid) and from the locally-generated CD WAD blob (cdmatrix_ref).
# Neither is source, and buildid.h by construction changes with every commit.
src/generated/buildid.h
src/generated/cdmatrix_ref.h
